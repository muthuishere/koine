{:paths ["src"]
 ;; No third-party dependencies, deliberately: koine must load on hosts that
 ;; cannot run Java-carrying libraries at all (see README).
 :deps  {org.clojure/clojure {:mvn/version "1.12.5"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}
  ;; Release tooling only — never on the library's own classpath, so the
  ;; "no third-party dependencies" promise above still holds for consumers.
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                       slipset/deps-deploy           {:mvn/version "0.2.2"}}
          :ns-default build}}}
